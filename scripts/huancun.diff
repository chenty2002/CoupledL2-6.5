+class DirectorySync(implicit p: Parameters)
+    extends HuanCunModule
+    with HasClientInfo {
+  private val sets = cacheParams.sets
+  private val ways = cacheParams.ways
+
+  val io = IO(new Bundle {
+    val selfDirW = Input(Valid(new SelfDirWrite))
+    val selfTagW = Input(Valid(new SelfTagWrite))
+    val clientDirW = Input(Valid(new ClientDirWrite))
+    val clientTagW = Input(Valid(new ClientTagWrite))
+    val selfDirArray = Output(Vec(sets, Vec(ways, new SelfDirEntry)))
+    val selfTagArray = Output(Vec(sets, Vec(ways, UInt(tagBits.W))))
+    val clientDirArray = Output(Vec(clientSets, Vec(clientWays, Vec(clientBits, new ClientDirEntry))))
+    val clientTagArray = Output(Vec(clientSets, Vec(clientWays, UInt(clientTagBits.W))))
+  })
+
+  private def selfDirInit() = 0.U.asTypeOf(new SelfDirEntry)
+  private def clientDirInit() = 0.U.asTypeOf(new ClientDirEntry)
+  private def clientVecInit() = VecInit(Seq.fill(clientBits)(clientDirInit()))
+
+  private val selfDirMirror = RegInit(VecInit(Seq.fill(sets)(VecInit(Seq.fill(ways)(selfDirInit())))))
+  private val selfTagMirror = RegInit(VecInit(Seq.fill(sets)(VecInit(Seq.fill(ways)(0.U(tagBits.W))))))
+  private val clientDirMirror = RegInit(VecInit(Seq.fill(clientSets)(VecInit(Seq.fill(clientWays)(clientVecInit())))))
+  private val clientTagMirror = RegInit(VecInit(Seq.fill(clientSets)(VecInit(Seq.fill(clientWays)(0.U(clientTagBits.W))))))
+
+  when(io.selfDirW.valid) {
+    selfDirMirror(io.selfDirW.bits.set)(io.selfDirW.bits.way) := io.selfDirW.bits.data
+  }
+  when(io.selfTagW.valid) {
+    selfTagMirror(io.selfTagW.bits.set)(io.selfTagW.bits.way) := io.selfTagW.bits.tag
+  }
+  when(io.clientDirW.valid) {
+    clientDirMirror(io.clientDirW.bits.set)(io.clientDirW.bits.way) := io.clientDirW.bits.data
+  }
+  when(io.clientTagW.valid) {
+    clientTagMirror(io.clientTagW.bits.set)(io.clientTagW.bits.way) := io.clientTagW.bits.tag
+  }
+
+  io.selfDirArray := selfDirMirror
+  io.selfTagArray := selfTagMirror
+  io.clientDirArray := clientDirMirror
+  io.clientTagArray := clientTagMirror
+}
