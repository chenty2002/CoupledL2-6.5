+class DataStorageSyncWrite(implicit p: Parameters) extends HuanCunBundle {
+  val addr = new DSAddress
+  val data = new DSData
+}
+
+class DataStorageSync(implicit p: Parameters) extends HuanCunModule {
+  private val beatsPerBlock = blockBytes / beatBytes
+  private val dataBits = beatBytes * 8
+  private val sets = cacheParams.sets
+  private val ways = cacheParams.ways
+
+  val io = IO(new Bundle {
+    val sinkD = Input(Valid(new DataStorageSyncWrite))
+    val sourceD = Input(Valid(new DataStorageSyncWrite))
+    val sinkC = Input(Valid(new DataStorageSyncWrite))
+    val dataArray = Output(Vec(sets, Vec(ways, Vec(beatsPerBlock, UInt(dataBits.W)))))
+  })
+
+  private def beatInit() = VecInit(Seq.fill(beatsPerBlock)(0.U(dataBits.W)))
+  private def wayInit() = VecInit(Seq.fill(ways)(beatInit()))
+  private val mirror = RegInit(VecInit(Seq.fill(sets)(wayInit())))
+
+  private def capture(port: Valid[DataStorageSyncWrite]): Unit = {
+    when(port.valid && port.bits.addr.write && !port.bits.addr.noop) {
+      mirror(port.bits.addr.set)(port.bits.addr.way)(port.bits.addr.beat) := port.bits.data.data
+    }
+  }
+
+  capture(io.sinkD)
+  capture(io.sourceD)
+  capture(io.sinkC)
+
+  io.dataArray := mirror
+}
